# img-gen settings. Copy to .env.local (never committed) and fill in only what you use.

# Which image model and prompt writer to use by default (names from config.mjs)
IMG_PROVIDER=mflux
PROMPT_WRITER=template

# Local image model (mflux on Apple silicon)
MFLUX_COMMAND=mflux-generate-z-image-turbo
MFLUX_MODEL=mflux-community/z-image-turbo-mflux-q4
QWEN_IMAGE_MODEL=

# Local text model that writes prompts (mlx_lm.server, LM Studio or Ollama)
LOCAL_LLM_URL=http://localhost:8090/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3-4B-4bit
LOCAL_LLM_KEY=local

# Any local OpenAI style image server
LOCAL_IMAGE_URL=http://localhost:8080/v1
LOCAL_IMAGE_MODEL=
LOCAL_IMAGE_KEY=local

# OpenAI (images and prompt writing)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-5-mini

# Anthropic Claude (prompt writing only, Claude does not draw images)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google Gemini (images)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Alibaba Cloud hosted Qwen-Image
DASHSCOPE_API_KEY=
DASHSCOPE_URL=https://dashscope-intl.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=qwen-image

# Replicate (any model, "owner/name")
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=qwen/qwen-image
